{
  "manifest_version": 3,
  "name": "Ambient Video for YouTube",
  "version": "1.1.0",
  "description": "Ambilight glow around the YouTube player, read straight from the video. Also opens YouTube TV (youtube.com/tv) in Chrome.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Ambient Video" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "tv", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/tv*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/tv*"],
      "js": ["tv-ua.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/tv*"],
      "js": ["tv.js"],
      "run_at": "document_start"
    }
  ]
}
