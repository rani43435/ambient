{
  "manifest_version": 3,
  "name": "Ambient Video – Glow for YouTube",
  "short_name": "Ambient Video",
  "version": "1.8.0",
  "description": "Ambilight for any video: YouTube, Vimeo and other sites. The colours at the edge glow softly around the player.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ambient Video"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/tv*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "anysite.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "fs-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rani43435.github.io/ambient/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    }
  ]
}
