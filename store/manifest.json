{
  "manifest_version": 3,
  "name": "Ambient Video – Glow for YouTube",
  "short_name": "Ambient Video",
  "version": "1.4.0",
  "description": "Ambilight for YouTube: the colours at the edge of the video glow softly around the player. Works in full screen.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Ambient Video" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/tv*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rani43435.github.io/ambient/*"],
      "js": ["site.js"],
      "run_at": "document_start"
    }
  ]
}
